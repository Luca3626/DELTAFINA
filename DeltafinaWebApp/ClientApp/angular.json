{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "angular-demo": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {
        "@schematics/angular:application": {
          "strict": true
        },
        "@schematics/angular:component": {
          "styleext": "scss",
          "inlineStyle": true,
          "spec": false
        },
        "@schematics/angular:class": {
          "spec": false
        },
        "@schematics/angular:directive": {
          "spec": false
        },
        "@schematics/angular:guard": {
          "spec": false
        },
        "@schematics/angular:module": {
          "spec": false
        },
        "@schematics/angular:pipe": {
          "spec": false
        },
        "@schematics/angular:service": {
          "spec": false
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/angular-demo",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "aot": true,
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",

              "src/styles.scss",
              {
                "input": "src/vendor/styles/rtl/appwork.scss",
                "bundleName": "vendor-styles-appwork",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/appwork-material.scss",
                "bundleName": "vendor-styles-appwork-material",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/appwork-dark.scss",
                "bundleName": "vendor-styles-appwork-dark",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/bootstrap.scss",
                "bundleName": "vendor-styles-bootstrap",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/bootstrap-material.scss",
                "bundleName": "vendor-styles-bootstrap-material",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/bootstrap-dark.scss",
                "bundleName": "vendor-styles-bootstrap-dark",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/colors.scss",
                "bundleName": "vendor-styles-colors",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/colors-material.scss",
                "bundleName": "vendor-styles-colors-material",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/colors-dark.scss",
                "bundleName": "vendor-styles-colors-dark",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/uikit.scss",
                "bundleName": "vendor-styles-uikit",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-air.scss",
                "bundleName": "vendor-styles-theme-air",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-air-material.scss",
                "bundleName": "vendor-styles-theme-air-material",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-air-dark.scss",
                "bundleName": "vendor-styles-theme-air-dark",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-corporate.scss",
                "bundleName": "vendor-styles-theme-corporate",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-corporate-material.scss",
                "bundleName": "vendor-styles-theme-corporate-material",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-corporate-dark.scss",
                "bundleName": "vendor-styles-theme-corporate-dark",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-cotton.scss",
                "bundleName": "vendor-styles-theme-cotton",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-cotton-material.scss",
                "bundleName": "vendor-styles-theme-cotton-material",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-cotton-dark.scss",
                "bundleName": "vendor-styles-theme-cotton-dark",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-gradient.scss",
                "bundleName": "vendor-styles-theme-gradient",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-gradient-material.scss",
                "bundleName": "vendor-styles-theme-gradient-material",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-gradient-dark.scss",
                "bundleName": "vendor-styles-theme-gradient-dark",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-paper.scss",
                "bundleName": "vendor-styles-theme-paper",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-paper-material.scss",
                "bundleName": "vendor-styles-theme-paper-material",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-paper-dark.scss",
                "bundleName": "vendor-styles-theme-paper-dark",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-shadow.scss",
                "bundleName": "vendor-styles-theme-shadow",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-shadow-material.scss",
                "bundleName": "vendor-styles-theme-shadow-material",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-shadow-dark.scss",
                "bundleName": "vendor-styles-theme-shadow-dark",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-soft.scss",
                "bundleName": "vendor-styles-theme-soft",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-soft-material.scss",
                "bundleName": "vendor-styles-theme-soft-material",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-soft-dark.scss",
                "bundleName": "vendor-styles-theme-soft-dark",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-sunrise.scss",
                "bundleName": "vendor-styles-theme-sunrise",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-sunrise-material.scss",
                "bundleName": "vendor-styles-theme-sunrise-material",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-sunrise-dark.scss",
                "bundleName": "vendor-styles-theme-sunrise-dark",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-twitlight.scss",
                "bundleName": "vendor-styles-theme-twitlight",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-twitlight-material.scss",
                "bundleName": "vendor-styles-theme-twitlight-material",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-twitlight-dark.scss",
                "bundleName": "vendor-styles-theme-twitlight-dark",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-vibrant.scss",
                "bundleName": "vendor-styles-theme-vibrant",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-vibrant-material.scss",
                "bundleName": "vendor-styles-theme-vibrant-material",
                "inject": false
              },
              {
                "input": "src/vendor/styles/rtl/theme-vibrant-dark.scss",
                "bundleName": "vendor-styles-theme-vibrant-dark",
                "inject": false
              }
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "lodash",
              "hammerjs",
              "numeral",
              "angular2-text-mask",
              "chartist",
              "chart.js",
              "nouislider"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractCss": true,
              "namedChunks": false,
              "buildOptimizer": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "50kb",
                  "maximumError": "100kb"
                }
              ]
            },
            "serve": {
              "extractCss": true,
              "namedChunks": true,
              "vendorChunk": true,
              "commonChunk": true,
              "verbose": false
            },
            "defaultConfiguration": "development"
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "angular-demo:build:serve"
          },
          "configurations": {
            "production": {
              "browserTarget": "angular-demo:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "angular-demo:build"
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "tsconfig.app.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    }
  },
  "defaultProject": "angular-demo",
  "cli": {
    "analytics": false
  }
}
